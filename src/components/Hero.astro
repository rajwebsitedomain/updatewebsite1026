---
---

<section class="relative pt-24 pb-14 md:pt-32 md:pb-20 overflow-hidden border-b-2 border-black">
  <div class="absolute inset-0 grid-bg"></div>
  <div class="absolute inset-0 halftone-bg"></div>

  <!-- Decorative subtle shapes -->
  <div class="absolute top-28 right-8 w-16 h-16 bg-neo-secondary/60 border-2 border-black rotate-12 hidden lg:block -z-0"></div>
  <div class="absolute bottom-12 left-6 w-12 h-12 bg-neo-muted/60 border-2 border-black -rotate-12 hidden lg:block -z-0"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Bio & Core Pitch -->
      <div class="lg:col-span-7">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 bg-neo-secondary border-2 border-black px-3.5 py-1 shadow-neo-sm -rotate-1 mb-5">
          <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse border border-black inline-block"></span>
          <span class="font-bold uppercase tracking-wider text-xs">Available for Cloud & DevOps Roles</span>
        </div>

        <!-- Main Title - Scaled & Balanced -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black uppercase leading-[1.05] tracking-tight mb-4 text-black">
          <span>Rajvardhan</span>
          <span class="text-stroke block sm:inline sm:ml-2">Singh</span>
          <span class="block mt-1">
            <span class="bg-neo-accent text-white px-3 py-0.5 border-2 border-black inline-block -rotate-1 shadow-neo-sm">
              Badgujar
            </span>
          </span>
        </h1>

        <!-- Focus Tags -->
        <div class="flex flex-wrap gap-2 mt-4 mb-5">
          <span class="bg-white border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-neo-sm">
            ☁️ AWS & Cloud Architecture
          </span>
          <span class="bg-white border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-neo-sm">
            🐳 Docker & Kubernetes
          </span>
          <span class="bg-white border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-neo-sm">
            ⚡ CI/CD Automation
          </span>
        </div>

        <!-- Hook Paragraph -->
        <p class="text-base sm:text-lg font-medium leading-relaxed max-w-xl text-gray-800 mb-6">
          I build <strong class="bg-neo-secondary px-1 border-b-2 border-black font-bold">scalable, secure, automated</strong> cloud infrastructure that bridges development and operations.
          <em class="block mt-1 text-sm font-semibold text-gray-700">"If you have to do it twice, automate it."</em>
        </p>

        <!-- Action CTAs -->
        <div class="flex flex-wrap gap-3">
          <a
            href="#projects"
            class="bg-black text-white border-2 border-black px-5 py-2.5 shadow-neo font-bold uppercase tracking-wider text-xs hover:-translate-y-0.5 hover:shadow-neo-lg transition-all inline-flex items-center gap-2"
          >
            <span>Explore Projects</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="#contact"
            class="bg-white text-black border-2 border-black px-5 py-2.5 shadow-neo font-bold uppercase tracking-wider text-xs hover:bg-neo-secondary hover:-translate-y-0.5 hover:shadow-neo-lg transition-all"
          >
            Contact Me
          </a>
          <a
            href="/rajcv.pdf"
            download="Rajvardhan_Singh_CV.pdf"
            class="bg-neo-secondary text-black border-2 border-black px-5 py-2.5 shadow-neo font-bold uppercase tracking-wider text-xs hover:bg-yellow-400 hover:-translate-y-0.5 hover:shadow-neo-lg transition-all inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download CV</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Neobrutal Cloud Terminal -->
      <div class="lg:col-span-5">
        <div class="bg-white border-2 border-black shadow-neo-lg rotate-1 relative">
          <!-- Terminal Header -->
          <div class="bg-neo-dark text-white border-b-2 border-black px-4 py-2 flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 border border-black inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-400 border border-black inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500 border border-black inline-block"></span>
              <span class="text-xs font-mono font-bold ml-2 text-gray-300">rajvardhan@cloud:~</span>
            </div>
            <span class="text-[10px] font-mono bg-black px-2 py-0.5 border border-gray-700 text-neo-mint">active</span>
          </div>

          <!-- Terminal Body / Key Stats -->
          <div class="p-5 font-mono text-xs space-y-3 bg-[#FAFAFA]">
            <div class="flex items-center justify-between border-b border-gray-200 pb-2">
              <span class="text-gray-500">$ location</span>
              <span class="font-bold text-black bg-neo-secondary px-1.5 py-0.5 border border-black">Indore, India 📍</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-200 pb-2">
              <span class="text-gray-500">$ education</span>
              <span class="font-bold text-black">BCA Final Year (Holkar)</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-200 pb-2">
              <span class="text-gray-500">$ cloud_projects</span>
              <span class="font-bold text-neo-accent">7+ Real-World Architectures</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-200 pb-2">
              <span class="text-gray-500">$ client_sites</span>
              <span class="font-bold text-black">4+ Production Deliveries</span>
            </div>
            <div class="flex items-center justify-between pb-1">
              <span class="text-gray-500">$ downtime</span>
              <span class="font-bold text-emerald-600 bg-emerald-50 px-1 border border-emerald-300">0.0s (Zero-Downtime)</span>
            </div>

            <!-- Terminal Stack Preview -->
            <div class="pt-2 border-t-2 border-black flex flex-wrap gap-1.5 font-sans font-bold text-[11px]">
              <span class="bg-neo-accent text-white px-2 py-0.5 border border-black">AWS EC2/S3</span>
              <span class="bg-neo-secondary text-black px-2 py-0.5 border border-black">Kubernetes</span>
              <span class="bg-neo-muted text-black px-2 py-0.5 border border-black">Terraform</span>
              <span class="bg-black text-white px-2 py-0.5 border border-black">GitHub Actions</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Animated Tech Marquee -->
<section class="bg-black text-white py-3 border-b-2 border-black overflow-hidden" aria-hidden="true">
  <div class="marquee-track animate-marquee">
    <span class="font-bold text-sm uppercase tracking-wider px-4 flex items-center gap-4">
      <span>AWS</span> <span>★</span> <span>Docker</span> <span>★</span> <span>Kubernetes</span> <span>★</span> <span>Terraform</span> <span>★</span> <span>Jenkins</span> <span>★</span> <span>GitHub Actions</span> <span>★</span> <span>Ansible</span> <span>★</span> <span>ArgoCD</span> <span>★</span> <span>Prometheus</span> <span>★</span> <span>Grafana</span> <span>★</span> <span>Linux</span> <span>★</span>
      <span>AWS</span> <span>★</span> <span>Docker</span> <span>★</span> <span>Kubernetes</span> <span>★</span> <span>Terraform</span> <span>★</span> <span>Jenkins</span> <span>★</span> <span>GitHub Actions</span> <span>★</span> <span>Ansible</span> <span>★</span> <span>ArgoCD</span> <span>★</span> <span>Prometheus</span> <span>★</span> <span>Grafana</span> <span>★</span> <span>Linux</span> <span>★</span>
    </span>
  </div>
</section>
