---

<section class="relative pt-24 pb-12 sm:pt-28 sm:pb-16 md:pt-36 md:pb-24 overflow-hidden border-b-2 border-black">
  <div class="absolute inset-0 grid-bg"></div>
  <div class="absolute inset-0 halftone-bg"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Bio & Core Pitch -->
      <div class="lg:col-span-7">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 bg-neo-secondary border-2 border-black px-3 sm:px-4 py-1 sm:py-1.5 shadow-neo-sm -rotate-1 mb-5 sm:mb-6 max-w-full">
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-emerald-500 rounded-full animate-pulse border border-black inline-block shrink-0"></span>
          <span class="font-bold uppercase tracking-wider text-xs sm:text-sm md:text-base">Available for Cloud & DevOps Roles</span>
        </div>

        <!-- Main Title - Bold & Confident -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase leading-[1.05] tracking-tight mb-5 text-black">
          <span>Rajvardhan</span>
          <span class="text-stroke block sm:inline sm:ml-2">Singh</span>
          <span class="block mt-1 sm:mt-2">
            <span class="bg-neo-accent text-white px-2.5 sm:px-3.5 py-0.5 sm:py-1 border-2 border-black inline-block -rotate-1 shadow-neo">
              Badgujar
            </span>
          </span>
        </h1>

        <!-- Focus Tags -->
        <div class="flex flex-wrap gap-2 sm:gap-2.5 mt-4 sm:mt-5 mb-5 sm:mb-6">
          <span class="bg-white border-2 border-black px-2.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm md:text-base font-bold uppercase tracking-wider shadow-neo-sm">
            AWS & Cloud Architecture
          </span>
          <span class="bg-white border-2 border-black px-2.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm md:text-base font-bold uppercase tracking-wider shadow-neo-sm">
            Docker & Kubernetes
          </span>
          <span class="bg-white border-2 border-black px-2.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm md:text-base font-bold uppercase tracking-wider shadow-neo-sm">
            CI/CD Automation
          </span>
        </div>

        <!-- Hook Paragraph -->
        <p class="text-base sm:text-lg md:text-xl font-medium leading-relaxed max-w-xl text-gray-800 mb-6 sm:mb-8">
          I build <strong class="bg-neo-secondary px-1.5 border-b-2 border-black font-bold">scalable, secure, automated</strong> cloud infrastructure that bridges development and operations.
          <em class="block mt-2 text-sm sm:text-base font-semibold text-gray-700">"If you have to do it twice, automate it."</em>
        </p>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-3.5">
          <a
            href="#projects"
            class="bg-black text-white border-2 border-black px-5 sm:px-6 py-3 sm:py-3.5 shadow-neo font-bold uppercase tracking-wider text-xs sm:text-sm md:text-base hover:-translate-y-0.5 hover:shadow-neo-lg transition-all inline-flex items-center justify-center gap-2 text-center"
          >
            <span>Explore Projects</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="#contact"
            class="bg-white text-black border-2 border-black px-5 sm:px-6 py-3 sm:py-3.5 shadow-neo font-bold uppercase tracking-wider text-xs sm:text-sm md:text-base hover:bg-neo-secondary hover:-translate-y-0.5 hover:shadow-neo-lg transition-all inline-flex items-center justify-center text-center"
          >
            Contact Me
          </a>
          <a
            href="/rajcv.pdf"
            download="Rajvardhan_Singh_CV.pdf"
            class="bg-neo-secondary text-black border-2 border-black px-5 sm:px-6 py-3 sm:py-3.5 shadow-neo font-bold uppercase tracking-wider text-xs sm:text-sm md:text-base hover:bg-yellow-400 hover:-translate-y-0.5 hover:shadow-neo-lg transition-all inline-flex items-center justify-center gap-2 text-center"
          >
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download CV</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Neobrutal Cloud Terminal -->
      <div class="lg:col-span-5">
        <div class="bg-white border-2 border-black shadow-neo sm:shadow-neo-lg rotate-0 lg:rotate-1 relative">
          <!-- Terminal Header -->
          <div class="bg-neo-dark text-white border-b-2 border-black px-4 py-2.5 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500 border border-black inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-400 border border-black inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500 border border-black inline-block"></span>
              <span class="text-xs sm:text-sm font-mono font-bold ml-2 text-gray-300">rajvardhan@cloud:~</span>
            </div>
            <span class="text-xs font-mono bg-black px-2 py-0.5 border border-gray-700 text-neo-mint">active</span>
          </div>

          <!-- Terminal Body / Key Stats -->
          <div class="p-4 sm:p-6 font-mono text-xs sm:text-sm space-y-3 sm:space-y-3.5 bg-[#FAFAFA]">
            <div class="flex items-center justify-between border-b border-gray-200 pb-2.5">
              <span class="text-gray-500">$ location</span>
              <span class="font-bold text-black bg-neo-secondary px-2 py-0.5 border border-black">Indore, India</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-200 pb-2.5">
              <span class="text-gray-500">$ education</span>
              <span class="font-bold text-black">BCA Final Year (Holkar)</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-200 pb-2.5">
              <span class="text-gray-500">$ cloud_projects</span>
              <span class="font-bold text-neo-accent">7+ Real-World Architectures</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-200 pb-2.5">
              <span class="text-gray-500">$ client_sites</span>
              <span class="font-bold text-black">4+ Production Deliveries</span>
            </div>
            <div class="flex items-center justify-between pb-1">
              <span class="text-gray-500">$ downtime</span>
              <span class="font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 border border-emerald-300">0.0s (Zero-Downtime)</span>
            </div>

            <!-- Terminal Stack Preview -->
            <div class="pt-3 border-t-2 border-black flex flex-wrap gap-2 font-sans font-bold text-xs">
              <span class="bg-neo-accent text-white px-2.5 py-1 border border-black">AWS EC2/S3</span>
              <span class="bg-neo-secondary text-black px-2.5 py-1 border border-black">Kubernetes</span>
              <span class="bg-neo-muted text-black px-2.5 py-1 border border-black">Terraform</span>
              <span class="bg-black text-white px-2.5 py-1 border border-black">GitHub Actions</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Animated Tech Marquee -->
