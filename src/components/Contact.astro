---
---

<section id="contact" class="py-16 md:py-24 border-b-2 border-black bg-neo-bg relative">
  <div class="absolute inset-0 grid-bg"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Contact Details -->
      <div class="lg:col-span-5">
        <div class="inline-block bg-neo-secondary border-2 border-black px-3.5 py-1.5 shadow-neo-sm -rotate-1 mb-3">
          <span class="font-bold uppercase tracking-wider text-xs sm:text-sm">07 — Let's Connect</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-black mb-4">
          <span>Let's</span>
          <span class="bg-neo-accent text-white px-3 py-1 border-2 border-black inline-block rotate-1 shadow-neo ml-1">
            Build
          </span>
          <span class="block mt-1">Together</span>
        </h2>

        <p class="text-sm sm:text-base font-medium leading-relaxed text-gray-700 mb-7">
          Open for Cloud & DevOps roles, infrastructure consulting, architecture audits, and tech collaborations. Reach out directly or submit the inquiry form.
        </p>

        <!-- Direct Contact Info Cards -->
        <div class="space-y-3">
          <a
            href="mailto:rajvardhancoder@gmail.com"
            class="flex items-center gap-3.5 bg-white border-2 border-black p-3.5 sm:p-4 shadow-neo-sm hover:-translate-y-0.5 hover:shadow-neo transition-all group"
          >
            <div class="w-10 h-10 bg-neo-accent text-white border-2 border-black flex items-center justify-center text-base font-bold shrink-0">
              ✉️
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Email</span>
              <span class="block text-sm sm:text-base font-black truncate text-black">rajvardhancoder@gmail.com</span>
            </div>
          </a>

          <a
            href="tel:+919770289936"
            class="flex items-center gap-3.5 bg-white border-2 border-black p-3.5 sm:p-4 shadow-neo-sm hover:-translate-y-0.5 hover:shadow-neo transition-all group"
          >
            <div class="w-10 h-10 bg-neo-secondary text-black border-2 border-black flex items-center justify-center text-base font-bold shrink-0">
              📞
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Phone</span>
              <span class="block text-sm sm:text-base font-black text-black">+91 97702 89936</span>
            </div>
          </a>

          <a
            href="https://github.com/singhrajvardhan"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3.5 bg-white border-2 border-black p-3.5 sm:p-4 shadow-neo-sm hover:-translate-y-0.5 hover:shadow-neo transition-all group"
          >
            <div class="w-10 h-10 bg-neo-muted text-black border-2 border-black flex items-center justify-center text-base font-bold shrink-0">
              💻
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">GitHub</span>
              <span class="block text-sm sm:text-base font-black truncate text-black">github.com/singhrajvardhan</span>
            </div>
          </a>

          <a
            href="https://www.linkedin.com/in/rajvardhan-singh-badgujar/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3.5 bg-white border-2 border-black p-3.5 sm:p-4 shadow-neo-sm hover:-translate-y-0.5 hover:shadow-neo transition-all group"
          >
            <div class="w-10 h-10 bg-neo-mint text-black border-2 border-black flex items-center justify-center text-base font-bold shrink-0">
              🔗
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">LinkedIn</span>
              <span class="block text-sm sm:text-base font-black truncate text-black">linkedin.com/in/rajvardhan-singh-badgujar</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Right Column: Clean Form -->
      <div class="lg:col-span-7">
        <form
          id="contact-form"
          class="bg-white border-2 border-black p-6 sm:p-8 shadow-neo"
        >
          <h3 class="text-base sm:text-lg font-black uppercase tracking-wider mb-5 border-b-2 border-black pb-3 text-black">
            Send an Inquiry
          </h3>

          <div class="space-y-4 sm:space-y-5">
            <div>
              <label for="name" class="block font-bold uppercase tracking-wider text-xs sm:text-sm mb-1.5 text-gray-800">
                Your Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g. Alex Morgan"
                class="w-full h-12 border-2 border-black bg-white font-medium text-sm sm:text-base px-3.5 focus:bg-neo-secondary/20 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block font-bold uppercase tracking-wider text-xs sm:text-sm mb-1.5 text-gray-800">
                Your Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="alex@company.com"
                class="w-full h-12 border-2 border-black bg-white font-medium text-sm sm:text-base px-3.5 focus:bg-neo-secondary/20 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="subject" class="block font-bold uppercase tracking-wider text-xs sm:text-sm mb-1.5 text-gray-800">
                Inquiry Topic <span class="text-red-500">*</span>
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full h-12 border-2 border-black bg-white font-medium text-sm sm:text-base px-3.5 focus:bg-neo-secondary/20 focus:outline-none transition-colors"
              >
                <option value="">Select an opportunity</option>
                <option value="DevOps Engineering Role">DevOps Engineering Role</option>
                <option value="Cloud Architecture Consulting">Cloud Architecture Consulting</option>
                <option value="CI/CD Pipeline Setup">CI/CD Pipeline Setup</option>
                <option value="Freelance Web Project">Freelance Web Project</option>
                <option value="Other">Other Collaboration</option>
              </select>
            </div>

            <div>
              <label for="message" class="block font-bold uppercase tracking-wider text-xs sm:text-sm mb-1.5 text-gray-800">
                Message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Share your requirements or role details..."
                class="w-full border-2 border-black bg-white font-medium text-sm sm:text-base p-3.5 resize-none focus:bg-neo-secondary/20 focus:outline-none transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-neo-accent text-white border-2 border-black h-13 shadow-neo-sm font-bold uppercase tracking-wider text-sm sm:text-base hover:-translate-y-0.5 hover:shadow-neo transition-all flex items-center justify-center gap-2.5 disabled:opacity-60 py-3"
            >
              <span id="btn-text">Submit Message</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
            </button>

            <div id="form-status" class="hidden text-center text-xs font-bold uppercase tracking-wide py-2"></div>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const formStatus = document.getElementById('form-status');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      formData.append('access_key', 'a4c3f2d9-4fc9-4ea9-882f-4884bf88d3bb');
      formData.append('from_name', 'Rajvardhan Portfolio Contact');

      if (!navigator.onLine) {
        formStatus.textContent = 'Unable to send message right now. Please email directly: rajvardhancoder@gmail.com';
        formStatus.className = 'block text-red-700 bg-red-100 border border-red-400 p-2 font-bold text-xs uppercase text-center';
        submitBtn.disabled = false;
        btnText.textContent = 'Submit Message';
        return;
      }

      submitBtn.disabled = true;
      btnText.textContent = 'Sending...';
      formStatus.classList.add('hidden');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          formStatus.textContent = '✅ Message sent successfully! I will reply shortly.';
          formStatus.className = 'block text-emerald-700 bg-emerald-50 border border-emerald-300 p-2 font-bold text-xs uppercase text-center';
          form.reset();
        } else {
          formStatus.textContent = '❌ Failed to send message. Please email rajvardhancoder@gmail.com directly.';
          formStatus.className = 'block text-red-700 bg-red-50 border border-red-300 p-2 font-bold text-xs uppercase text-center';
        }
      } catch (err) {
        formStatus.textContent = '⚠️ Network error. Please email rajvardhancoder@gmail.com.';
        formStatus.className = 'block text-yellow-700 bg-yellow-50 border border-yellow-300 p-2 font-bold text-xs uppercase text-center';
      }

      submitBtn.disabled = false;
      btnText.textContent = 'Submit Message';
    });
  }
</script>
