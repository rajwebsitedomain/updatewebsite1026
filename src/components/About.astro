<section id="about" class="py-14 md:py-20 border-b-2 border-black bg-neo-bg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="mb-10">
      <div class="inline-block bg-neo-muted border-2 border-black px-3 py-1 shadow-neo-sm rotate-1 mb-3">
        <span class="font-bold uppercase tracking-wider text-xs">01 — Profile</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-black">
        <span>Who</span>
        <span class="bg-neo-secondary px-2.5 py-0.5 border-2 border-black inline-block -rotate-1 shadow-neo-sm ml-1">
          Am I?
        </span>
      </h2>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Bio & Core Stats -->
      <div class="lg:col-span-7 space-y-6">
        <p class="text-base sm:text-lg font-medium leading-relaxed text-gray-800">
          I'm <strong class="bg-neo-accent text-white px-1.5 py-0.5 border border-black font-bold">Rajvardhan Singh Badgujar</strong>, a passionate Cloud & DevOps Engineer and final-year BCA student from Indore, India. I specialize in architecting scalable, secure, and automated cloud infrastructure that bridges development and operations.
        </p>
        <p class="text-sm sm:text-base leading-relaxed text-gray-700">
          My philosophy is simple: <strong class="bg-neo-secondary px-1 border border-black">"If you have to do it twice, automate it."</strong> Whether it's setting up declarative Kubernetes clusters, writing modular Terraform templates, or automating complex multi-stage deployment pipelines, I focus on stability, velocity, and observability.
        </p>

        <!-- Metric Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
          <div class="bg-white border-2 border-black p-3.5 shadow-neo-sm text-center">
            <span class="block text-2xl sm:text-3xl font-black text-neo-accent">7+</span>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-gray-600 mt-1">Cloud Builds</span>
          </div>
          <div class="bg-white border-2 border-black p-3.5 shadow-neo-sm text-center">
            <span class="block text-2xl sm:text-3xl font-black text-neo-secondary">4+</span>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-gray-600 mt-1">Client Sites</span>
          </div>
          <div class="bg-white border-2 border-black p-3.5 shadow-neo-sm text-center">
            <span class="block text-2xl sm:text-3xl font-black text-neo-muted">80%</span>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-gray-600 mt-1">Faster CI/CD</span>
          </div>
          <div class="bg-white border-2 border-black p-3.5 shadow-neo-sm text-center">
            <span class="block text-2xl sm:text-3xl font-black text-black">0s</span>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-gray-600 mt-1">Downtime</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Key Highlights -->
      <div class="lg:col-span-5">
        <div class="bg-white border-2 border-black p-5 sm:p-6 shadow-neo">
          <h3 class="text-base font-black uppercase tracking-wider mb-4 border-b-2 border-black pb-2 flex items-center justify-between">
            <span>Engineering Highlights</span>
            <span class="text-xs font-mono bg-neo-secondary px-2 py-0.5 border border-black">2023–2026</span>
          </h3>

          <ul class="space-y-3 text-xs sm:text-sm font-medium text-gray-800">
            <li class="flex items-start gap-2.5">
              <span class="bg-neo-accent text-white border border-black px-1.5 py-0.5 text-xs font-bold shrink-0 mt-0.5">✓</span>
              <span>Architected and deployed <strong>7+ production cloud systems</strong> with Docker, AWS, and Linux.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="bg-neo-secondary border border-black px-1.5 py-0.5 text-xs font-bold shrink-0 mt-0.5">✓</span>
              <span>Delivered <strong>4+ commercial websites</strong> with zero-downtime hosting configurations.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="bg-neo-muted border border-black px-1.5 py-0.5 text-xs font-bold shrink-0 mt-0.5">✓</span>
              <span>Engineered automated GitHub Actions pipelines reducing release cycles by <strong>80%</strong>.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="bg-neo-mint border border-black px-1.5 py-0.5 text-xs font-bold shrink-0 mt-0.5">✓</span>
              <span>Final year BCA student at <strong>Govt. Holkar Science College, Indore</strong> with deep Linux/DevOps focus.</span>
            </li>
          </ul>

          <div class="mt-5 pt-3 border-t-2 border-dashed border-gray-300 flex items-center justify-between text-xs font-bold">
            <span class="text-gray-600">Base Location:</span>
            <span class="bg-black text-white px-2 py-0.5">Indore, MP, India 📍</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
