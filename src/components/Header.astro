---
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-neo-bg/95 backdrop-blur-sm border-b-2 border-black transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 md:h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a
      href="/"
      class="bg-neo-accent border-2 border-black px-4 py-2 shadow-neo-sm font-black text-base sm:text-lg uppercase tracking-wider hover:-translate-y-0.5 hover:shadow-neo transition-all active:translate-x-[1px] active:translate-y-[1px] inline-block text-black"
      aria-label="Rajvardhan Singh Badgujar Homepage"
    >
      <span>RSB</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-2">
      <a
        href="/about"
        class="font-bold text-sm uppercase tracking-wider px-3.5 py-2 rounded-sm border-2 border-transparent hover:border-black hover:bg-neo-secondary hover:shadow-neo-sm transition-all"
      >
        About
      </a>
      <a
        href="/#skills"
        class="font-bold text-sm uppercase tracking-wider px-3.5 py-2 rounded-sm border-2 border-transparent hover:border-black hover:bg-neo-secondary hover:shadow-neo-sm transition-all"
      >
        Skills
      </a>
      <a
        href="/#projects"
        class="font-bold text-sm uppercase tracking-wider px-3.5 py-2 rounded-sm border-2 border-transparent hover:border-black hover:bg-neo-secondary hover:shadow-neo-sm transition-all"
      >
        Projects
      </a>
      <a
        href="/#faq"
        class="font-bold text-sm uppercase tracking-wider px-3.5 py-2 rounded-sm border-2 border-transparent hover:border-black hover:bg-neo-secondary hover:shadow-neo-sm transition-all"
      >
        FAQ
      </a>
      <a
        href="/#contact"
        class="bg-black text-white border-2 border-black px-4 py-2 shadow-neo-sm font-bold text-sm uppercase tracking-wider hover:-translate-y-0.5 hover:shadow-neo transition-all ml-1"
      >
        Contact
      </a>
      <a
        href="/rajcv.pdf"
        download="Rajvardhan_Singh_CV.pdf"
        class="bg-neo-secondary text-black border-2 border-black px-4 py-2 shadow-neo-sm font-bold text-sm uppercase tracking-wider hover:-translate-y-0.5 hover:shadow-neo transition-all inline-flex items-center gap-1.5 ml-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>CV</span>
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden bg-white border-2 border-black p-2.5 shadow-neo-sm active:translate-x-[1px] active:translate-y-[1px] transition-all"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-x-0 top-18 sm:top-20 bg-neo-bg border-b-2 border-black shadow-neo-lg p-5 hidden transition-all duration-200"
  >
    <div class="flex flex-col gap-2.5 max-w-sm mx-auto">
      <a href="/about" class="mobile-link bg-white border-2 border-black p-3.5 font-bold text-base uppercase tracking-wider shadow-neo-sm hover:bg-neo-secondary flex items-center justify-between">
        <span>👤 About Profile</span>
        <span>→</span>
      </a>
      <a href="/#skills" class="mobile-link bg-white border-2 border-black p-3.5 font-bold text-base uppercase tracking-wider shadow-neo-sm hover:bg-neo-muted flex items-center justify-between">
        <span>🛠️ Skills</span>
        <span>→</span>
      </a>
      <a href="/#projects" class="mobile-link bg-white border-2 border-black p-3.5 font-bold text-base uppercase tracking-wider shadow-neo-sm hover:bg-neo-accent hover:text-white flex items-center justify-between">
        <span>🚀 Projects</span>
        <span>→</span>
      </a>
      <a href="/#faq" class="mobile-link bg-white border-2 border-black p-3.5 font-bold text-base uppercase tracking-wider shadow-neo-sm hover:bg-neo-secondary flex items-center justify-between">
        <span>💡 FAQ</span>
        <span>→</span>
      </a>
      <a href="/#contact" class="mobile-link bg-black text-white border-2 border-black p-3.5 font-bold text-base uppercase tracking-wider shadow-neo-sm flex items-center justify-between">
        <span>📬 Contact</span>
        <span>→</span>
      </a>
      <a href="/rajcv.pdf" download="Rajvardhan_Singh_CV.pdf" class="mobile-link bg-neo-secondary border-2 border-black p-3.5 font-bold text-base uppercase tracking-wider shadow-neo-sm flex items-center justify-center gap-2 mt-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Download Resume (PDF)</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
