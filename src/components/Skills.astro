---
import { skillCategories } from '../data/skills';
---

<section id="skills" class="py-16 md:py-24 border-b-2 border-black bg-neo-secondary/30 relative">
  <div class="absolute inset-0 grid-bg"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Section Header -->
    <div class="mb-12 text-center sm:text-left">
      <div class="inline-block bg-black text-white border-2 border-black px-3.5 py-1.5 shadow-neo-sm -rotate-1 mb-3">
        <span class="font-bold uppercase tracking-wider text-xs sm:text-sm">02 — Expertise</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-black">
        <span>Technical</span>
        <span class="bg-white px-3 py-1 border-2 border-black inline-block rotate-1 shadow-neo ml-1">
          Stack
        </span>
      </h2>
      <p class="text-sm sm:text-base font-medium text-gray-700 mt-2.5 max-w-xl">
        Production-tested tools, cloud platforms, and automation technologies I work with daily.
      </p>
    </div>

    <!-- Skills Categorized Grid -->
    <div class="space-y-7">
      {skillCategories.map((category) => (
        <div class="bg-white border-2 border-black p-5 sm:p-6 shadow-neo">
          <h3 class="text-sm sm:text-base font-black uppercase tracking-widest text-gray-700 mb-4 flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 bg-neo-accent inline-block border border-black"></span>
            <span>{category.title}</span>
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
            {category.skills.map((skill) => (
              <div class="border border-black bg-neo-bg p-3.5 sm:p-4 shadow-neo-sm hover:-translate-y-0.5 hover:shadow-neo transition-all flex items-start gap-3">
                <span class="text-2xl shrink-0" aria-hidden="true">{skill.icon}</span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-xs sm:text-sm uppercase tracking-wide text-black">{skill.name}</span>
                    <span class="text-xs font-mono font-bold text-gray-600">{skill.level}%</span>
                  </div>
                  <p class="text-xs text-gray-600 truncate mt-1" title={skill.detail}>{skill.detail}</p>
                  <!-- Progress bar -->
                  <div class="w-full bg-gray-200 h-2 border border-black mt-2.5 overflow-hidden">
                    <div class="bg-neo-accent h-full" style={`width: ${skill.level}%`}></div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
