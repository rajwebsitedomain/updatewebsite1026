---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
}

const { title, description, canonicalUrl, ogImage, type, jsonLd } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <SEOHead
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    ogImage={ogImage}
    type={type}
    jsonLd={jsonLd}
  />
  <body class="bg-neo-bg text-black font-sans antialiased selection:bg-neo-accent selection:text-white">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Silent Service Worker Registration for Offline Access -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <!-- Universal Visitor Tracker v4.0 -->
    <script is:inline src="/tracker.js"></script>
  </body>
</html>
