---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Privacy Policy · Rajvardhan Singh Badgujar";
const pageDescription = "Privacy policy, data protection standards, and user rights for Rajvardhan Singh Badgujar's portfolio and professional cloud services.";

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rajvardhansingh.in/' },
    { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: 'https://rajvardhansingh.in/privacy' },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="/privacy"
  jsonLd={[breadcrumbSchema]}
>
  <div class="pt-24 pb-16 md:pt-32 md:pb-24 max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-black">Home</a>
      <span>/</span>
      <span class="text-black bg-neo-secondary px-1.5 py-0.5 border border-black">Privacy Policy</span>
    </nav>

    <div class="bg-white border-2 border-black p-6 sm:p-10 shadow-neo">
      <div class="inline-block bg-neo-muted border-2 border-black px-3 py-1 shadow-neo-sm rotate-1 mb-4">
        <span class="font-bold uppercase tracking-wider text-xs">Compliance & Data Protection</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-black mb-2">
        Privacy Policy
      </h1>
      <p class="text-xs font-mono font-bold text-gray-500 mb-8 border-b-2 border-black pb-3">
        Effective Date: October 2026 · Scope: rajvardhansingh.in
      </p>

      <div class="prose max-w-none text-xs sm:text-sm text-gray-800 leading-relaxed space-y-5">
        
        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>1.</span>
            <span>Data Controller Information</span>
          </h2>
          <p>
            This website (<strong>rajvardhansingh.in</strong>) is operated and managed by <strong>Rajvardhan Singh Badgujar</strong>, located in Indore, Madhya Pradesh, India. I am committed to safeguarding the privacy and personal data of all visitors, recruiters, and clients interacting with this platform.
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>2.</span>
            <span>Information We Collect</span>
          </h2>
          <p class="mb-2">We adhere strictly to data minimization principles. We only collect information voluntarily provided by you:</p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Contact Submissions:</strong> Full name, professional email address, subject category, and message body submitted via the contact form.</li>
            <li><strong>Server Diagnostic Logs:</strong> Anonymized request headers, IP address (hashed or truncated for diagnostic security), timestamp, user-agent, and requested URI paths for preventing abuse and maintaining server uptime.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>3.</span>
            <span>Form Processing & Third-Party Processors</span>
          </h2>
          <p>
            Contact submissions are routed through <strong>Web3Forms</strong>, an encrypted form transmission service. Form payloads are delivered directly to the designated email mailbox (<code class="bg-gray-100 px-1 border border-black text-[11px]">rajvardhancoder@gmail.com</code>). Data is transmitted over HTTPS with TLS 1.3 encryption. We do not sell, rent, or trade submission data with third-party advertising networks.
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>4.</span>
            <span>Zero Tracking Cookies & Analytics</span>
          </h2>
          <p>
            This website does <strong>not</strong> load marketing trackers, behavioral profiling scripts, or intrusive third-party advertising cookies. Any traffic metrics collected are aggregate and privacy-preserving (e.g. server-side request counts and Core Web Vitals telemetry).
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>5.</span>
            <span>Data Retention & Security</span>
          </h2>
          <p>
            Correspondence resulting from inquiries is retained only as long as necessary to conduct professional discussions regarding employment, consulting engagements, or ongoing collaborations. We implement standard security headers (<code class="bg-gray-100 px-1 border border-black text-[11px]">X-Content-Type-Options: nosniff</code>, <code class="bg-gray-100 px-1 border border-black text-[11px]">X-Frame-Options: SAMEORIGIN</code>, strict referrer policies, and HTTPS encryption).
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>6.</span>
            <span>Your Rights</span>
          </h2>
          <p>
            Regardless of your geographic location, you retain the right to:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li>Request confirmation regarding whether we process your contact information.</li>
            <li>Request a copy of any personal data you have submitted.</li>
            <li>Request permanent deletion of your inquiry data and email records.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>7.</span>
            <span>Contact & Inquiries</span>
          </h2>
          <p>
            For data protection inquiries or deletion requests, contact Rajvardhan directly:
          </p>
          <div class="bg-neo-bg border border-black p-3.5 mt-2 space-y-1 font-mono text-xs">
            <p><strong>Email:</strong> rajvardhancoder@gmail.com</p>
            <p><strong>Telephone:</strong> +91 97702 89936</p>
            <p><strong>Address:</strong> 75, Mahaveer Bagh, Navlakh, Indore, MP 452001, India</p>
          </div>
        </section>

      </div>

      <div class="mt-8 pt-4 border-t border-gray-200 flex items-center justify-between">
        <a href="/" class="text-xs font-bold uppercase tracking-wider text-black hover:text-neo-accent">
          ← Return to Portfolio
        </a>
        <a href="/about" class="text-xs font-bold uppercase tracking-wider text-black hover:text-neo-accent">
          View Engineering Profile →
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
