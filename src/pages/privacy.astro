---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Privacy Policy · Rajvardhan Singh Badgujar";
const pageDescription = "Privacy policy, data protection standards, and user rights for Rajvardhan Singh Badgujar's portfolio and professional cloud services.";

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rajvardhansingh.in/' },
    { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: 'https://rajvardhansingh.in/privacy' },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="/privacy"
  jsonLd={[breadcrumbSchema]}
>
  <div class="pt-24 pb-16 md:pt-32 md:pb-24 max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-black">Home</a>
      <span>/</span>
      <span class="text-black bg-neo-secondary px-1.5 py-0.5 border border-black">Privacy Policy</span>
    </nav>

    <div class="bg-white border-2 border-black p-6 sm:p-10 shadow-neo">
      <div class="inline-block bg-neo-muted border-2 border-black px-3 py-1 shadow-neo-sm rotate-1 mb-4">
        <span class="font-bold uppercase tracking-wider text-xs">Compliance & Data Protection</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-black mb-2">
        Privacy Policy
      </h1>
      <p class="text-xs font-mono font-bold text-gray-500 mb-8 border-b-2 border-black pb-3">
        Effective Date: October 2026 · Scope: rajvardhansingh.in
      </p>

      <div class="prose max-w-none text-xs sm:text-sm text-gray-800 leading-relaxed space-y-5">
        
        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>1.</span>
            <span>Data Controller Information</span>
          </h2>
          <p>
            This website (<strong>rajvardhansingh.in</strong>) is operated and managed by <strong>Rajvardhan Singh Badgujar</strong>, located in Indore, Madhya Pradesh, India. I am committed to safeguarding the privacy and personal data of all visitors, recruiters, and clients interacting with this platform.
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>2.</span>
            <span>Information We Collect</span>
          </h2>
          <p class="mb-2">We adhere to transparent data practices and collect the following categories of information:</p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>Contact Submissions:</strong> Full name, professional email address, subject category, and message body submitted voluntarily via the contact form.</li>
            <li><strong>Usage & Telemetry (Universal Visitor Tracker v4.0):</strong> To understand audience engagement, optimize performance, and evaluate portfolio usability, our client-side tracker collects non-personally identifiable diagnostic and behavioral data:
              <ul class="list-[circle] pl-5 mt-1 space-y-1 text-gray-700">
                <li><strong>Anonymous Identifiers:</strong> A randomly generated pseudonymous user token (<code class="bg-gray-100 px-1 border border-black text-[11px]">_ut_userId</code>) stored in browser LocalStorage, and a session token (<code class="bg-gray-100 px-1 border border-black text-[11px]">_ut_sessionId</code>) stored in SessionStorage.</li>
                <li><strong>Navigation & Traffic Sources:</strong> Current page URL, page title, detected site label, language preference, HTTP referrer, landing page URL, and incoming UTM campaign parameters (<code class="bg-gray-100 px-1 border border-black text-[11px]">utm_source</code>, <code class="bg-gray-100 px-1 border border-black text-[11px]">utm_medium</code>).</li>
                <li><strong>Interaction & Engagement:</strong> Pageview events, scroll depth milestones (25%, 50%, 75%, 100%), element click coordinates (tag name, ID, class list), and dwell duration / time spent upon navigation exit.</li>
                <li><strong>Device & Environment:</strong> Browser user-agent string, operating system platform, device type (Mobile or Desktop), screen resolution, client locale/language, and timezone.</li>
              </ul>
            </li>
            <li><strong>Server Diagnostic Logs:</strong> Anonymized edge request headers, truncated IP addresses for security diagnostics, timestamps, and requested URI paths for preventing abuse and maintaining server uptime.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>3.</span>
            <span>Third-Party Processors & Infrastructure</span>
          </h2>
          <p class="mb-2">We route site submissions and telemetry through trusted technical providers:</p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>Web3Forms:</strong> Contact submissions are securely transmitted over HTTPS with TLS 1.3 encryption directly to <code class="bg-gray-100 px-1 border border-black text-[11px]">rajvardhancoder@gmail.com</code>.</li>
            <li><strong>Supabase Edge Functions:</strong> Telemetry and interaction events collected by the Universal Visitor Tracker are transmitted directly over HTTPS/sendBeacon to a secure cloud function endpoint (<code class="bg-gray-100 px-1 border border-black text-[11px]">fmrmiylqjokyrsztfmgp.supabase.co/functions/v1/track-visitor</code>) for aggregation and dashboard analytics.</li>
          </ul>
          <p class="mt-2 text-xs text-gray-700">
            We do <strong>not</strong> sell, rent, monetize, or broker collected data to third-party advertisers, data syndicators, or cross-site tracking networks.
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>4.</span>
            <span>Client Storage & Tracking Controls</span>
          </h2>
          <p class="mb-2">
            This site does <strong>not</strong> use third-party marketing or cross-site advertising cookies. Instead, lightweight browser-native storage mechanisms are used for anonymous visit continuity:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li><code class="bg-gray-100 px-1 border border-black text-[11px]">localStorage._ut_userId</code>: An anonymous token allowing aggregate recognition of repeat visits.</li>
            <li><code class="bg-gray-100 px-1 border border-black text-[11px]">sessionStorage._ut_sessionId</code>: Temporary session token automatically purged when your browser session closes.</li>
            <li><code class="bg-gray-100 px-1 border border-black text-[11px]">sessionStorage._ut_landing</code>: First page viewed in current session to assess landing UX.</li>
          </ul>
          <p class="mt-2">
            <strong>How to opt-out:</strong> You can clear your browser's Local Storage and Session Storage at any time through developer tools or privacy settings. You may also disable JavaScript or utilize privacy-focused browser extensions. Elements designated with <code class="bg-gray-100 px-1 border border-black text-[11px]">.no-track</code> are excluded from click capture.
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>5.</span>
            <span>Data Retention & Security</span>
          </h2>
          <p>
            Contact inquiries are retained only for the duration required to conduct professional communication. Aggregated telemetry logs stored in Supabase are periodically archived or pruned. All transmissions enforce modern TLS encryption, Content Security Policies, and strict HTTP security headers (<code class="bg-gray-100 px-1 border border-black text-[11px]">X-Content-Type-Options: nosniff</code>, <code class="bg-gray-100 px-1 border border-black text-[11px]">X-Frame-Options: SAMEORIGIN</code>).
          </p>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>6.</span>
            <span>Your Rights</span>
          </h2>
          <p>
            Regardless of your geographic location, you retain the right to:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li>Request confirmation regarding whether we process your contact information or personal data.</li>
            <li>Request a copy of any personal data you have submitted via the contact form.</li>
            <li>Request permanent deletion of your inquiry messages and associated email records.</li>
            <li>Inspect and purge local/session storage tokens stored on your device.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-sm font-black uppercase border-b-2 border-black pb-1 mb-2 text-black flex items-center gap-2">
            <span>7.</span>
            <span>Contact & Inquiries</span>
          </h2>
          <p>
            For data protection inquiries or deletion requests, contact Rajvardhan directly:
          </p>
          <div class="bg-neo-bg border border-black p-3.5 mt-2 space-y-1 font-mono text-xs">
            <p><strong>Email:</strong> rajvardhancoder@gmail.com</p>
            <p><strong>Telephone:</strong> +91 97702 89936</p>
            <p><strong>Address:</strong> 75, Mahaveer Bagh, Navlakh, Indore, MP 452001, India</p>
          </div>
        </section>

      </div>

      <div class="mt-8 pt-4 border-t border-gray-200 flex items-center justify-between">
        <a href="/" class="text-xs font-bold uppercase tracking-wider text-black hover:text-neo-accent">
          ← Return to Portfolio
        </a>
        <a href="/about" class="text-xs font-bold uppercase tracking-wider text-black hover:text-neo-accent">
          View Engineering Profile →
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
